@using System.Security.Claims

@if (User.Identity?.IsAuthenticated == true)
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <span class="nav-link text-dark">
                @User.FindFirst(ClaimTypes.Email)?.Value (@User.FindFirst(ClaimTypes.Role)?.Value)
            </span>
        </li>
        <li class="nav-item">
            <form asp-controller="Cuenta" asp-action="Logout" method="post" class="form-inline">
                <button type="submit" class="btn btn-link nav-link text-dark border-0">Cerrar sesión</button>
            </form>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
        </li>
    </ul>
}
