@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutAcceso";

    // Si el ingreso falló, el email vuelve cargado: sólo hay que corregir la contraseña.
    // La contraseña no se devuelve nunca.
    var emailIngresado = Context.Request.HasFormContentType ? Context.Request.Form["email"].ToString() : "";
}

@* Íconos de la pantalla, tomados de docs/prototipo-interfaz.html. *@
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
        <g id="i-calc"><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M8 7h8M8 12h2M14 12h2M8 16.5h2M14 16.5h2" /></g>
        <g id="i-pdf"><path d="M6 3h8l5 5v13H6z" /><path d="M14 3v5h5M9 14h6M9 17.5h4" /></g>
        <g id="i-upload"><path d="M12 16V5M8 9l4-4 4 4" /><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" /></g>
        <g id="i-mail"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></g>
        <g id="i-lock"><rect x="5" y="10" width="14" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></g>
        <g id="i-eye"><path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12" /><circle cx="12" cy="12" r="2.6" /></g>
    </defs>
</svg>

<div class="acceso">
    <section class="acceso-marca" aria-label="Presentación del sistema">
        <div>
            <div class="acceso-nombre">SIGERE</div>
            <p class="acceso-bajada">Sistema de gestión de retenciones del Impuesto a las Ganancias.
                Régimen de la RG&nbsp;830.</p>
        </div>
        <div class="rasgos">
            <div class="rasgo">
                <span class="rasgo-icono"><svg class="icono" width="19" height="19" viewBox="0 0 24 24"><use href="#i-calc" /></svg></span>
                <div>
                    <div class="rasgo-titulo">Acumulado automático</div>
                    <div class="rasgo-detalle">El sistema busca las operaciones anteriores del mes y aplica el piso una sola vez.</div>
                </div>
            </div>
            <div class="rasgo">
                <span class="rasgo-icono"><svg class="icono" width="19" height="19" viewBox="0 0 24 24"><use href="#i-pdf" /></svg></span>
                <div>
                    <div class="rasgo-titulo">Certificados numerados</div>
                    <div class="rasgo-detalle">Numeración correlativa asignada por el sistema, sin saltos ni repeticiones.</div>
                </div>
            </div>
            <div class="rasgo">
                <span class="rasgo-icono"><svg class="icono" width="19" height="19" viewBox="0 0 24 24"><use href="#i-upload" /></svg></span>
                <div>
                    <div class="rasgo-titulo">Exportación para SICORE</div>
                    <div class="rasgo-detalle">Archivo de 145 posiciones, con formato numérico independiente del equipo.</div>
                </div>
            </div>
        </div>
    </section>

    <main class="acceso-formulario">
        <div class="acceso-caja">
            <h1 class="acceso-titulo">Iniciar sesión</h1>
            <p class="acceso-texto">Ingresá tus datos para acceder al sistema.</p>

            @* Sin action: el formulario se envía a la misma URL, conservando el ReturnUrl.
               El tag helper de <form> agrega igual el token antifalsificación, que el
               controlador exige con [ValidateAntiForgeryToken]. *@
            <form method="post">
                @* Si el ingreso falla, el controlador agrega el error al ModelState y
                   este resumen lo muestra como aviso de error dentro de la tarjeta. *@
                <div asp-validation-summary="All" class="aviso aviso-error" role="alert"></div>

                <div class="acceso-campo">
                    <label for="email">Correo electrónico</label>
                    <div class="campo-con-icono">
                        <svg class="icono" width="16" height="16" viewBox="0 0 24 24"><use href="#i-mail" /></svg>
                        <input id="email" name="email" type="email" class="campo-control"
                               value="@emailIngresado" autocomplete="username" required
                               autofocus="@(string.IsNullOrEmpty(emailIngresado))" />
                    </div>
                </div>

                <div class="acceso-campo">
                    <label for="password">Contraseña</label>
                    <div class="campo-con-icono">
                        <svg class="icono" width="16" height="16" viewBox="0 0 24 24"><use href="#i-lock" /></svg>
                        <input id="password" name="password" type="password" class="campo-control"
                               autocomplete="current-password" required
                               autofocus="@(!string.IsNullOrEmpty(emailIngresado))" />
                        <button type="button" class="campo-boton" id="mostrar-password"
                                aria-label="Mostrar contraseña" aria-pressed="false" aria-controls="password">
                            <svg class="icono" width="16" height="16" viewBox="0 0 24 24"><use href="#i-eye" /></svg>
                        </button>
                    </div>
                </div>

                <button type="submit" class="boton boton-primario boton-grande acceso-boton">Ingresar</button>
            </form>

            <div class="acceso-pie">
                <svg class="icono" width="13" height="13" viewBox="0 0 24 24"><use href="#i-lock" /></svg>
                Acceso para el estudio contable y sus clientes
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        // Mostrar u ocultar la contraseña. Cambia el tipo del campo entre
        // "password" y "text"; aria-pressed le indica el estado al lector de pantalla.
        (function () {
            var boton = document.getElementById('mostrar-password');
            var campo = document.getElementById('password');
            boton.addEventListener('click', function () {
                var visible = campo.type === 'password';
                campo.type = visible ? 'text' : 'password';
                boton.setAttribute('aria-pressed', visible ? 'true' : 'false');
                boton.setAttribute('aria-label', visible ? 'Ocultar contraseña' : 'Mostrar contraseña');
                campo.focus();
            });
        })();
    </script>
}
