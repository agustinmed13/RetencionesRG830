@model List<RetencionesRG830.Domain.Entidades.Regimen>

@{
    ViewData["Title"] = "Regímenes RG 830";
}

<h1>Regímenes de la RG 830 cargados</h1>

<table class="table">
    <thead>
        <tr>
            <th>Código</th>
            <th>Descripción</th>
            <th>Tasa inscriptos</th>
            <th>Piso no sujeto a retención</th>
            <th>Mínimo de retención</th>
            <th>Vigente desde</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var regimen in Model)
        {
            <tr>
                <td>@regimen.Codigo</td>
                <td>@regimen.Descripcion</td>
                <td>
                    @(regimen.TipoCalculo == RetencionesRG830.Domain.Enums.TipoCalculoRegimen.TasaFija
                        ? regimen.TasaInscripto.ToString("P1")
                        : $"Según escala ({regimen.Tramos.Count} tramos)")
                </td>
                <td>@regimen.MontoNoSujetoARetencion.ToString("C0")</td>
                <td>@regimen.MinimoRetencion.ToString("C0")</td>
                <td>@regimen.VigenciaDesde.ToString("dd/MM/yyyy")</td>
            </tr>
        }
    </tbody>
</table>