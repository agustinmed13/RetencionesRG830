@model RetencionesRG830.Domain.Entidades.Operacion
@*
    Detalle de una operación ya registrada: es la pantalla con la que el contador
    verifica una retención. No tiene pantalla propia en docs/prototipo-interfaz.html:
    se arma con los componentes de la Confirmación (datos en dos columnas y el total
    destacado) y se compara contra esa pantalla.

    Muestra lo que quedó guardado en la operación, sin recalcular nada.

    No usa _DesgloseCalculo: el parcial recibe un ResultadoCalculoRetencion, y la
    operación no guarda todo lo que hace falta para armarlo. Guarda la base acumulada
    y el monto retenido, pero no la condición del proveedor ni las retenciones
    anteriores de ese momento. Recalcular con los datos de hoy podría mostrar un
    cálculo distinto del que se practicó.
*@
@{
    var anulada = Model.Anulada;
    var titulo = anulada ? "Operación anulada" : "Operación registrada";
    ViewData["Title"] = titulo;
}

<ol class="migas">
    <li><a asp-action="Index">Operaciones</a></li>
    <li>Detalle</li>
</ol>

@* La anulación se ve en tres lugares antes de leer un dato: el título, el tag y el
   aviso. Además el total va en rojo y tachado, porque en verde parecería vigente. *@
<div class="cabecera-pagina">
    <h1>@titulo</h1>
    <span class="tag @(anulada ? "tag-anulada" : "tag-vigente")">@(anulada ? "Anulada" : "Vigente")</span>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="aviso" role="status">
        <svg class="icono" width="18" height="18" viewBox="0 0 24 24"><use href="#i-alert" /></svg>
        <span>@TempData["Mensaje"]</span>
    </div>
}

@if (anulada)
{
    <div class="aviso aviso-error" role="note">
        <svg class="icono" width="18" height="18" viewBox="0 0 24 24"><use href="#i-alert" /></svg>
        <span>
            <b>Operación anulada</b> el @(Model.FechaAnulacion?.ToString("dd/MM/yyyy HH:mm")). Motivo: @Model.MotivoAnulacion<br />
            No suma al acumulado del mes y no se informa en SICORE.@(Model.TieneCertificado ? " Conserva su número de certificado, que no se reutiliza." : "")
        </span>
    </div>
}

<div class="tarjeta">
    <div class="resumen">
        <div class="dato">
            <div class="etiqueta">Certificado</div>
            @if (Model.NumeroCertificado is int numero)
            {
                <div class="valor numero-certificado">N° @FormatoComprobante.NumeroCertificado(numero)</div>
            }
            else
            {
                <div class="valor"><span class="tag tag-sin-certificado">Sin certificado</span></div>
            }
        </div>
        <div class="dato"><div class="etiqueta">Agente de retención</div><div class="valor">@Model.Cliente?.RazonSocial</div></div>
        <div class="dato"><div class="etiqueta">Proveedor</div><div class="valor">@Model.Proveedor?.RazonSocial</div></div>
        <div class="dato"><div class="etiqueta">CUIT del proveedor</div><div class="valor cuit">@FormatoCuit.ParaMostrar(Model.Proveedor?.Cuit)</div></div>
        <div class="dato"><div class="etiqueta">Comprobante</div><div class="valor">@FormatoComprobante.NombreTipo(Model.TipoComprobante) @Model.PuntoVenta.ToString("D5")-@Model.NumeroComprobante.ToString("D8")</div></div>
        @* Con qué versión del régimen se calculó (regla 9). La operación guarda el
           RegimenId de la versión usada: cambiar de versión después no la altera. *@
        <div class="dato">
            <div class="etiqueta">Régimen</div>
            <div class="valor"><span class="regimen">@Model.Regimen?.Codigo</span> @Model.Regimen?.Descripcion</div>
            <div class="texto-atenuado">Valores vigentes desde <span class="fecha">@Model.Regimen?.VigenciaDesde.ToString("dd/MM/yyyy")</span></div>
        </div>
        <div class="dato"><div class="etiqueta">Fecha del comprobante</div><div class="valor fecha">@Model.FechaComprobante.ToString("dd/MM/yyyy")</div></div>
        <div class="dato"><div class="etiqueta">Fecha de la retención</div><div class="valor fecha">@Model.FechaRetencion.ToString("dd/MM/yyyy")</div></div>
        <div class="dato"><div class="etiqueta">Importe total</div><div class="valor cifras">@Model.ImporteComprobante.ToString("C2")</div></div>
        <div class="dato"><div class="etiqueta">Importe gravado</div><div class="valor cifras">@Model.ImporteGravado.ToString("C2")</div></div>
    </div>

    @* La base y la retención salen de lo que quedó guardado. La base es la del momento
       de registrar: no cambia si después se anula otra operación del mes. Por eso dice
       "con esta operación", y por eso no se muestra en una anulada, que ya no suma al
       acumulado: el renglón afirmaría algo falso. *@
    <div class="desglose">
        @if (!anulada)
        {
            <div class="renglon">
                <span class="etiqueta">Base acumulada del mes con esta operación</span>
                <span class="valor">@Model.BaseCalculoAcumulada.ToString("C2")</span>
            </div>
        }
        <div class="renglon renglon-total @(anulada ? "renglon-total-anulada" : "")">
            <span class="etiqueta">Retención practicada</span>
            <span class="valor">@Model.MontoRetenido.ToString("C2")</span>
        </div>
    </div>

    @* Regla 10: sin retención no hay certificado que descargar. En su lugar, el motivo.
       MotivoSinCertificado dice que la operación suma al acumulado, lo que deja de ser
       cierto si se la anuló. *@
    @if (!Model.TieneCertificado)
    {
        <div class="nota-panel">
            <svg class="icono" width="15" height="15" viewBox="0 0 24 24"><use href="#i-info" /></svg>
            <span>@(anulada ? "No se emitió certificado: la retención a practicar fue $ 0." : FormatoComprobante.MotivoSinCertificado)</span>
        </div>
    }

    <div class="pie-formulario">
        <a asp-action="Index" class="boton boton-neutro">Volver al listado</a>
        @if (!anulada)
        {
            <a asp-action="Anular" asp-route-id="@Model.Id" class="boton boton-peligro">Anular</a>
            @* Regla 11: a un cliente de baja no se le cargan operaciones. *@
            @if (Model.Cliente?.Activo == true)
            {
                <a asp-action="Create" asp-route-clienteId="@Model.ClienteId"
                   class="boton @(Model.TieneCertificado ? "boton-secundario" : "boton-primario")">Cargar otra</a>
            }
            @if (Model.TieneCertificado)
            {
                <a asp-action="Certificado" asp-route-id="@Model.Id" class="boton boton-primario" target="_blank">Descargar certificado (PDF)</a>
            }
        }
    </div>
</div>
