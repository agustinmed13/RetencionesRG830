@model RetencionesRG830.Web.Models.SimuladorViewModel

@{
    ViewData["Title"] = "Simulador de retención";
}

<h1>Simulador de retención</h1>
<p class="text-muted">
    Reproduce el cálculo de la hoja "Cálculo" de la planilla, usando los
    regímenes cargados en la base de datos.
</p>

<div class="row">
    <div class="col-md-5">
        <form asp-action="Index" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="RegimenId" class="form-label"></label>
                <select asp-for="RegimenId" asp-items="ViewBag.Regimenes" class="form-select">
                    <option value="">-- Elegí un régimen --</option>
                </select>
                <span asp-validation-for="RegimenId" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="InscriptoEnGanancias" class="form-check-input" />
                <label asp-for="InscriptoEnGanancias" class="form-check-label"></label>
            </div>

            <div class="mb-3">
                <label asp-for="TipoPersona" class="form-label"></label>
                <select asp-for="TipoPersona"
                        asp-items="Html.GetEnumSelectList<RetencionesRG830.Domain.Enums.TipoPersona>()"
                        class="form-select"></select>
                <div class="form-text">Sólo influye si el proveedor NO está inscripto.</div>
            </div>

            <div class="mb-3">
                <label asp-for="NetoGravadoAcumuladoMensual" class="form-label"></label>
                <input asp-for="NetoGravadoAcumuladoMensual" type="number" step="0.01" class="form-control" />
                <div class="form-text">Incluye la operación que se está cargando ahora.</div>
                <span asp-validation-for="NetoGravadoAcumuladoMensual" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RetencionesAcumuladasDelMes" class="form-label"></label>
                <input asp-for="RetencionesAcumuladasDelMes" type="number" step="0.01" class="form-control" />
                <div class="form-text">Lo que ya se le retuvo antes en el mismo mes.</div>
                <span asp-validation-for="RetencionesAcumuladasDelMes" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Calcular</button>
        </form>
    </div>

    <div class="col-md-7">
        @if (Model.Resultado is not null)
        {
            <div class="card">
                <div class="card-header">Resultado del cálculo</div>
                <table class="table mb-0">
                    <tbody>
                        <tr>
                            <td>Mínimo no sujeto a retención</td>
                            <td class="text-end">@Model.Resultado.MinimoNoSujetoARetencion.ToString("C2")</td>
                        </tr>
                        <tr>
                            <td>Tasa aplicable</td>
                            <td class="text-end">
                                @(Model.Resultado.TasaAplicada == 0
                                    ? "s/escala"
                                    : Model.Resultado.TasaAplicada.ToString("P2"))
                            </td>
                        </tr>
                        <tr>
                            <td>Neto sujeto a retención</td>
                            <td class="text-end">@Model.Resultado.NetoSujetoARetencion.ToString("C2")</td>
                        </tr>
                        <tr>
                            <td>Retención acumulada determinada</td>
                            <td class="text-end">@Model.Resultado.RetencionAcumuladaDeterminada.ToString("C2")</td>
                        </tr>
                        <tr class="table-primary fw-bold">
                            <td>Retención a practicar</td>
                            <td class="text-end">@Model.Resultado.RetencionAPracticar.ToString("C2")</td>
                        </tr>
                    </tbody>
                </table>
                @if (!string.IsNullOrEmpty(Model.Resultado.Observacion))
                {
                    <div class="card-footer text-muted">@Model.Resultado.Observacion</div>
                }
            </div>
        }
    </div>
</div>