@model RetencionesRG830.Domain.Entidades.Proveedor
@*
    Edición de proveedor. El formulario está en _FormularioProveedor.cshtml.

    El cliente se muestra como texto en la banda, igual que en "Nueva operación":
    es parte de la identidad del proveedor y no se edita. Se lee de la base (el
    controlador carga Cliente), nunca del formulario. Si está de baja se dice, para
    que se entienda por qué no aparece en otras listas.
*@
@{
    ViewData["Title"] = "Editar proveedor";
}

<ol class="migas">
    <li><a asp-action="Index" asp-route-clienteId="@Model.ClienteId">Proveedores</a></li>
    <li>Editar proveedor</li>
</ol>
<h1>Editar proveedor</h1>

<div class="banda">
    <svg class="icono" width="18" height="18" viewBox="0 0 24 24"><use href="#i-users" /></svg>
    <span>
        Agente de retención: <b>@Model.Cliente?.RazonSocial</b>@if (Model.Cliente is not null){<text> · CUIT <span class="cuit">@Model.Cliente.Cuit</span></text>}
    </span>
    @if (Model.Cliente is { Activo: false })
    {
        <span class="tag tag-inactivo">De baja</span>
    }
</div>

<partial name="_FormularioProveedor" model="Model" />
